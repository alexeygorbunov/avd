!
no enable password
no aaa root
!
username admin privilege 15 role network-admin secret sha512 $6$MIU0emRg9c.0IznA$uj3Y.TRvmcTJHhjiWrSM7pHlrT/d/MLLI.izGHhu2PSu9vhPoUznc5mJwaV73V.q1InLUXl5FwSKGNkXPw/6V1
!
daemon TerminAttr
   exec /usr/bin/TerminAttr -cvaddr=apiserver.cv-staging.corp.arista.io:443 -cvauth=token-secure,/tmp/cv-onboarding-token -cvvrf=MGMT -disableaaa -smashexcludes=ale,flexCounter,hardware,kni,pulse,strata -ingestexclude=/Sysdb/cell/1/agent,/Sysdb/cell/2/agent -taillogs
   no shutdown
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname {{ inventory_hostname }}
ip name-server vrf MGMT {{ lookup('env', 'SINGLE_DC_L3LS_DC1_MGMT_DNS') }}
!
vrf instance MGMT
!
management api http-commands
   protocol https
   no shutdown
   !
   vrf MGMT
      no shutdown
!
interface Management1
   description OOB_MANAGEMENT
   no shutdown
   vrf MGMT
   ip address {{ lookup('env', 'SINGLE_DC_L3LS_' ~ (inventory_hostname | replace("-", "_") | upper)) }}/{{ lookup('env', 'SINGLE_DC_L3LS_DC1_MGMT_MASK') }}
!
no ip routing
no ip routing vrf MGMT
!
ip route vrf MGMT 0.0.0.0/0 {{ lookup('env', 'SINGLE_DC_L3LS_DC1_MGMT_GW') }}
!
ntp local-interface vrf MGMT Management1
ntp server vrf MGMT 0.pool.ntp.org prefer
ntp server vrf MGMT 1.pool.ntp.org
!
end
